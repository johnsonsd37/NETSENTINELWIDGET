<Window x:Class="NetSentinelWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Net Sentinel" Width="430" Height="570"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip">
  <Border CornerRadius="18" Background="#F21A1D24" BorderBrush="#394150" BorderThickness="1" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel MouseLeftButtonDown="DragWindow">
        <TextBlock Text="NET SENTINEL" Foreground="#AAB4C8" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Content="×" Click="CloseWindow" Width="28" Height="28" Foreground="#DCE4F2" Background="Transparent" BorderThickness="0" FontSize="20"/>
      </DockPanel>

      <Border Grid.Row="1" x:Name="StatusCard" Background="#192B243A" CornerRadius="12" Padding="12" Margin="0,12,0,12">
        <StackPanel>
          <TextBlock x:Name="StatusText" Text="Monitoring network activity" Foreground="#67E8A5" FontWeight="Bold" FontSize="15"/>
          <TextBlock x:Name="StatusDetail" Text="No unusual outbound transfer detected" Foreground="#AAB4C8" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Grid Grid.Row="2" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="#202530" CornerRadius="12" Padding="14" Margin="0,0,6,0">
          <StackPanel><TextBlock Text="↓ DOWNLOAD" Foreground="#86B7FF" FontSize="11"/><TextBlock x:Name="DownloadRate" Text="0 B/s" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="DownloadTotal" Text="Total 0 B" Foreground="#8791A3" FontSize="11"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#202530" CornerRadius="12" Padding="14" Margin="6,0,0,0">
          <StackPanel><TextBlock Text="↑ UPLOAD" Foreground="#F5A6A6" FontSize="11"/><TextBlock x:Name="UploadRate" Text="0 B/s" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="UploadTotal" Text="Total 0 B" Foreground="#8791A3" FontSize="11"/></StackPanel>
        </Border>
      </Grid>

      <StackPanel Grid.Row="3">
        <DockPanel Margin="0,0,0,8"><TextBlock Text="ACTIVE TCP CONNECTIONS" Foreground="#AAB4C8" FontSize="11"/><TextBlock x:Name="ConnectionCount" DockPanel.Dock="Right" Foreground="#8791A3"/></DockPanel>
        <ListView x:Name="ConnectionsList" Background="Transparent" BorderThickness="0" Foreground="#DFE6F2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Process}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Remote}" Foreground="#9DA8BA" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="#67E8A5" HorizontalAlignment="Right"/>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </StackPanel>

      <StackPanel Grid.Row="4" Margin="0,12,0,0">
        <CheckBox x:Name="StartupToggle" Content="Start automatically when I sign in" IsChecked="True" Foreground="#D5DCE8" Checked="StartupChanged" Unchecked="StartupChanged" Margin="0,0,0,6"/>
        <CheckBox x:Name="AlertToggle" Content="Alert on sustained upload" IsChecked="True" Foreground="#D5DCE8"/>
        <TextBlock Text="Warning threshold: 5 MB/s for 5 seconds. Network use is an indicator, not proof of file theft." Foreground="#778194" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
